# Copy to .env and fill in. .env is gitignored and must never be committed.

# Hugging Face — model/dataset search, adapter push, Spaces deploy (Ch2, Ch3)
HF_TOKEN=

# Weights & Biases — training/eval run tracking (Ch1, Ch2)
WANDB_API_KEY=

# GitHub — mining real diffs for the independent eval set (C2), repo ops
GITHUB_TOKEN=

# Frontier API — synthetic data generation only, ~$1 total budget (C3)
ANTHROPIC_API_KEY=
# Price used by the data_gen budget guard; never hardcoded in source (see 03-system-design §1.2)
PRICE_PER_1K_TOKENS=

# Escape hatches — set deliberately, per command, never exported in your shell profile.
# ALLOW_FULL_RUN=1   # lets the GPU-budget hook through. Only on the GPU box.
# EVAL_CONTEXT=1     # lets the leakage guard read eval/holdout/. Only for /eval.
