{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReviewOutput",
  "type": "object",
  "required": ["severity", "category", "line", "issue", "suggested_fix"],
  "additionalProperties": false,
  "properties": {
    "severity": {
      "type": "string",
      "enum": ["critical", "major", "minor", "info"]
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "line": {
      "type": "integer",
      "minimum": 1
    },
    "issue": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "suggested_fix": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    }
  }
}
